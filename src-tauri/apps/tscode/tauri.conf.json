{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tscode",
  "version": "0.1.0",
  "identifier": "dev.tscode.app",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "tscode",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "useHttpsScheme": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' blob:",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data: asset: http://asset.localhost https://asset.localhost",
        "img-src": "'self' data: blob: asset: http://asset.localhost https://asset.localhost",
        "connect-src": "'self' data: blob: ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Explorer, search, multi-repo source control and the integrated terminal on Tauri.",
    "longDescription": "tscode is a Tauri port of a subset of VS Code: the explorer, search and multi-repo source control views, and the integrated terminal.",
    "resources": {
      "../../../resources/extensions": "resources/extensions",
      "../../../src/vs/workbench/contrib/terminal/common/scripts": "out/vs/workbench/contrib/terminal/common/scripts"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
